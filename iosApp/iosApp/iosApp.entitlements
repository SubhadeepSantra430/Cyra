<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reference/starting-point entitlements file for "Sign in with Apple" - NOT yet wired
  into project.pbxproj's CODE_SIGN_ENTITLEMENTS build setting or the target's Signing &
  Capabilities list. Adding the "Sign in with Apple" capability to the iosApp target in
  Xcode (Signing & Capabilities tab) generates/wires this correctly and is a one-time
  manual step - editing the .pbxproj by hand here risks corrupting the Xcode project
  file, so it's intentionally left for you to do in the Xcode GUI. Once added, Xcode may
  overwrite this exact file with an equivalent one, which is expected.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
